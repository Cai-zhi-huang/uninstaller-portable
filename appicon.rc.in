#include <windows.h>

// 程序主图标，编译进 exe，作为文件图标与默认窗口图标。
IDI_APP_ICON ICON "assets/appicon.ico"

// UAC 清单：显式声明以普通用户(asInvoker)运行，禁止 uiAccess。
// 缺少此清单时，Windows“安装程序检测”会因 exe 名含 "uninstall" 而自动提权，
// 导致整个 GUI 以管理员身份运行、放大攻击面（见安全审计报告 F10）。
#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif
1 RT_MANIFEST "app.manifest"

// 版本信息：由 CMake 从 api/ui/version.hpp 的 APP_VERSION 自动注入（单一版本来源）。
// 注意：llvm-rc 无法解析 VERSIONINFO 里的非 ASCII 字符，故此处 VALUE 使用英文/数字；
// 文件属性中显示的版本为数字主版本（如 0.0.0），中文“试用版”后缀在窗口标题与“关于”中展示。
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @APP_VERSION_COMMA@
 PRODUCTVERSION @APP_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "CZH720"
            VALUE "FileDescription", "Uninstaller Manager"
            VALUE "FileVersion", "@APP_VERSION_DOT@"
            VALUE "InternalName", "uninstaller"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "uninstaller.exe"
            VALUE "ProductName", "Uninstaller Manager"
            VALUE "ProductVersion", "@APP_VERSION_DOT@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 0x4b0
    END
END
